/**
 * South Valley Weather MCP Server
 * Cloudflare Worker configuration
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "south-valley-weather-mcp-server",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-02",
	"compatibility_flags": ["nodejs_compat"],

	"observability": {
		"enabled": true
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "south-valley-weather-db",
			"database_id": "cffaf3c3-f518-41a7-b45a-e59902688cb3"
		}
	]
}
